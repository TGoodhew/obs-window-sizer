{
  "version": 8,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-x64",
      "displayName": "Windows x64",
      "description": "Build obs-window-sizer for Windows x64 (VS 2026 / MSVC v145)",
      "binaryDir": "${sourceDir}/build_x64",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "generator": "Visual Studio 18 2026",
      "architecture": "x64,version=10.0.22621",
      "warnings": {
        "dev": true,
        "deprecated": true
      },
      "cacheVariables": {
        "ENABLE_FRONTEND_API": true,
        "ENABLE_QT": true
      }
    },
    {
      "name": "windows-ci-x64",
      "inherits": "windows-x64",
      "displayName": "Windows x64 CI",
      "description": "CI build. Uses the VS 2022 generator, which is what GitHub runners provide, and treats warnings as errors.",
      "generator": "Visual Studio 17 2022",
      "cacheVariables": {
        "ENABLE_FRONTEND_API": true,
        "ENABLE_QT": true,
        "CMAKE_COMPILE_WARNING_AS_ERROR": true
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-x64",
      "configurePreset": "windows-x64",
      "displayName": "Windows x64",
      "description": "Windows build for x64",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "windows-x64-debug",
      "configurePreset": "windows-x64",
      "displayName": "Windows x64 (Debug)",
      "description": "Windows debug build for x64",
      "configuration": "Debug"
    },
    {
      "name": "windows-ci-x64",
      "configurePreset": "windows-ci-x64",
      "displayName": "Windows x64 CI",
      "description": "CI build for x64",
      "configuration": "RelWithDebInfo"
    }
  ]
}
